{
	"name": "@workspace/ui-react",
	"private": true,
	"type": "module",
	"exports": {
		"./components/*": "./src/components/*/index.ts",
		"./icons": "./src/icons.ts",
		"./hooks/*": "./src/hooks/*.ts"
	},
	"scripts": {
		"dev": "portless",
		"dev:app": "storybook dev --no-open",
