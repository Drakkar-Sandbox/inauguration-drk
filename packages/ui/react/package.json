		"name": "ui.e5",
		"script": "dev:app"
	},
	"peerDependencies": {
		"@workspace/ui-theme": "workspace:*",
		"react": "19",
		"react-dom": "19",
		"tailwindcss": "4"
	},
	"dependencies": {
		"@base-ui/react": "1.8.0",
		"lucide-react": "1.49.0",
		"sonner": "2.0.8",
		"tailwind-variants": "3.3.1"
	},
	"devDependencies": {
		"@rolldown/plugin-babel": "0.2.4",
		"@storybook/addon-docs": "10.6.1",
		"@storybook/addon-themes": "10.6.1",
		"@storybook/react-vite": "10.6.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"storybook": "10.6.1",
		"typescript": "7.0.2",
		"vite": "8.3.2"
	}
