# Server Config
NODE_ENV=development
TZ=UTC
PORT=3333
HOST=localhost
APP_URL=https://api.e5.localhost
LOG_LEVEL=info
# Proxies allowed to set X-Forwarded-For (client IP for rate limiting):
# loopback (default) | false | true | <hop count> | <ip1,ip2>
TRUST_PROXY=loopback
APP_KEY=

# Frontend Config
FRONTEND_URL=https://web.e5.localhost

# Event Config
EVENT_AVATAR_NAME=Leif

# Leif AI Config (optional: leave keys empty for the scripted, text-only mode)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# Session Config
SESSION_DRIVER=cookie

# Database Config
DB_HOST=127.0.0.1
DB_PORT=5432
DB_PORT_TEST=5433
DB_USER=root
DB_PASSWORD=supersecret
DB_DATABASE=app

# Mail Config
MAIL_MAILER=smtp
MAIL_FROM_NAME=E5 Stack
MAIL_FROM_ADDRESS=noreply@e5-stack.com

# SMTP Config
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_WEB_PORT=5000

# Redis Config
REDIS_CONNECTION=main
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=supersecret

# Rate Limiter Config
LIMITER_STORE=redis

# Queue Config
QUEUE_DRIVER=redis

# Drive Config
DRIVE_DRIVER=fs

# Sentry Config
SENTRY_ENABLED=false
SENTRY_DSN=https://ingest.de.sentry.io
SENTRY_ENV=development